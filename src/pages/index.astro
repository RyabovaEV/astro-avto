---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Hero from "@/components/sections/home/Hero.astro";
import InsuranceBanner from "@/components/sections/home/InsuranceBanner.astro";
import Button from "@/components/ui/Button.astro";
---

<Layout
  title="Главная"
  description="Официальный сайт ООО АВТО, ООО КПАП —
пассажирские перевозки в Киришах и Киришском районе. Расписание автобусов,
контакты, автошкола."
>
  <Hero />
  <InsuranceBanner />
  <div class="flex flex-col gap-15 py-25">
    <Section
      title="Новости"
      description="Последние новости и события компании."
      id="news"
    >
      <Button
        slot="action"
        variant="outline"
        href="/"
        label="Все новости"
        iconRight="ChevronRight"
      />
      Новости
    </Section>
    <Section
      title="Документы"
      description="Нормативные и правовые документы"
      id="docs"
    >
      <Button
        slot="action"
        variant="outline"
        href="/"
        label="Все документы"
        iconRight="ChevronRight"
      />
      Документы
    </Section>
  </div>
</Layout>
