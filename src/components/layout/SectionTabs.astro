---
import type { NavSection } from "@/config/navigation";
import { cn } from "@/utils/cn";
import { getTabHref, isTabActive } from "@/utils/navigation";

interface Props {
  section: NavSection;
  ariaLabel: string;
  class?: string;
}

const { section, ariaLabel, class: className } = Astro.props as Props;

const pathname = Astro.url.pathname;

const baseStyle =
  "focus-ring block rounded-lg px-4 py-2 text-sm font-semibold whitespace-nowrap transition-colors";
---

<nav aria-label={ariaLabel} class="-m-1.5">
  <ul
    class={cn(
      "flex gap-2 overflow-x-auto flex-nowrap lg:overflow-visible lg:flex-wrap p-1.5",
      className,
    )}
  >
    {
      section.tabs.map((tabItem) => {
        const href = getTabHref(section, tabItem);
        const isActive = isTabActive(section, tabItem, pathname);
        return (
          <li>
            <a
              href={href}
              class={cn(
                baseStyle,
                isActive
                  ? "bg-primary text-primary-foreground"
                  : "bg-secondary text-link-menu hover:text-foreground",
              )}
              aria-current={isActive ? "page" : undefined}
            >
              {tabItem.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
