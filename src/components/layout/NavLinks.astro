---
import type { NavSection } from "@/config/navigation";
import { cn } from "@/utils/cn";
import { getSectionHref, isSectionActive } from "@/utils/navigation";

interface Props {
  sections: NavSection[];
  variant: "mobile" | "desktop";
}

const { sections, variant } = Astro.props as Props;

const pathname = Astro.url.pathname;
const isMobile = variant === "mobile";
---

<ul class={cn("flex gap-2", isMobile && "flex-col")}>
  {
    sections.map((navItem) => {
      const isActive = isSectionActive(navItem, pathname);
      return (
        <li>
          <a
            href={getSectionHref(navItem)}
            class={cn(
              "text-link-menu hover:bg-accent hover:text-foreground focus-ring rounded px-4 py-2 text-sm font-semibold",
              isMobile && "block w-full",
              isActive && "bg-accent text-primary",
            )}
            aria-current={isActive ? "page" : undefined}
          >
            {navItem.label}
          </a>
        </li>
      );
    })
  }
</ul>
