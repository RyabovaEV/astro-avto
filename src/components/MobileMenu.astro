---
import type { NavItem } from "@/config/navigation";
import type { CollectionEntry } from "astro:content";
import NavLinks from "./NavLinks.astro";
import PhoneList from "./PhoneList.astro";

interface Props {
  navItems: NavItem[];
  phones: CollectionEntry<"phones">["data"][];
}

const { navItems, phones } = Astro.props as Props;
---

<details class="lg:hidden">
  <summary class="burger focus-ring" aria-label="Открыть меню">
    <span class="burgerLine"></span>
    <span class="burgerLine"></span>
    <span class="burgerLine"></span>
  </summary>

  <div class="panel">
    <nav aria-label="Мобильная навигация" class="px-4 py-3">
      <NavLinks items={navItems} variant="mobile" />
    </nav>
    <div class="border-border border-t"></div>
    <div class="px-4 py-4">
      <PhoneList phones={phones} variant="mobile" />
    </div>
  </div>
</details>

<style>
  .burger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    list-style: none;
    padding: 10px 7px;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    z-index: var(--z-burger);
    transition: background-color var(--transition-duration) ease;
  }

  .burger::-webkit-details-marker {
    display: none;
  }
  .burger::marker {
    display: none;
  }

  .burger:hover {
    background-color: var(--secondary);
  }

  .burgerLine {
    height: 3px;
    border-radius: var(--radius-sm);
    background-color: var(--primary);
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
    transform-origin: center;
  }

  details[open] > .burger .burgerLine:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }
  details[open] > .burger .burgerLine:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  details[open] > .burger .burgerLine:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  .panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background-color: var(--card);
    border-block: 1px solid var(--border);
    box-shadow: 0 8px 16px -8px rgb(0 0 0 / 0.12);
    z-index: var(--z-mobile-menu);
  }
</style>
