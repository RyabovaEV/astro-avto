---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";
import { NavItems } from "@/config/navigation";
import NavLinks from "./NavLinks.astro";
import PhoneList from "./PhoneList.astro";
import MobileMenu from "./MobileMenu.astro";

const REQUIRED_SIGNATURES = ["MAIN", "DISP"] as const;

const phones = await getCollection("phones", ({ data }) =>
  (REQUIRED_SIGNATURES as readonly string[]).includes(data.signature),
);

const missing = REQUIRED_SIGNATURES.filter(
  (sig) => !phones.some((p) => p.data.signature === sig),
);

if (missing.length) {
  throw new Error(
    `В коллекции phones не найдены signature: ${missing.join(", ")}`,
  );
}
---

<header class="relative">
  <div
    class="container mx-auto flex items-center justify-between px-4 py-6 lg:py-10"
  >
    <Logo />
    <nav class="hidden lg:block" aria-label="Основная навигация">
      <NavLinks items={NavItems} variant="desktop" />
    </nav>
    <div class="hidden xl:block">
      <PhoneList phones={phones.map((p) => p.data)} variant="desktop" />
    </div>
    <MobileMenu navItems={NavItems} phones={phones.map((p) => p.data)} />
  </div>
</header>
