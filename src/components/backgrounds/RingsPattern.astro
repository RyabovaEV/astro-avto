---
import { cn } from "@/utils/cn";

interface Props {
  countRings?: number;
  step?: number;
  class?: string;
}

const {
  countRings = 8,
  step = 120,
  class: className = "",
} = Astro.props as Props;

const steps = Array.from({ length: countRings }, (_, i) => (i + 1) * step);
---

<div class={cn("absolute pointer-events-none", className)} aria-hidden="true">
  {
    steps.map((size) => (
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/40"
        style={`width:${size}px; height:${size}px;`}
      />
    ))
  }
</div>
