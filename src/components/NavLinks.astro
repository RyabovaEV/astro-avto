---
import type { NavItem } from "@/config/navigation";
import { cn } from "@/utils/cn";

interface Props {
  items: NavItem[];
  variant: "mobile" | "desktop";
}

const { items, variant } = Astro.props as Props;

const pathname = Astro.url.pathname;
const isMobile = variant === "mobile";
---

<ul class={cn("flex gap-2", isMobile && "flex-col")}>
  {
    items.map((navItem) => {
      const isActive = navItem.href === pathname;
      return (
        <li>
          <a
            href={navItem.href}
            class={cn(
              "text-link-menu hover:bg-accent hover:text-foreground focus-ring rounded px-4 py-2 text-sm font-semibold",
              isMobile && "block w-full",
              isActive && "bg-accent text-primary",
            )}
          >
            {navItem.label}
          </a>
        </li>
      );
    })
  }
</ul>
