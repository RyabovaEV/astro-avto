---
import { cn } from "@/utils/cn";

interface Props {
  tag?: "div" | "section" | "article" | "li" | "ul" | "ol";
  variant?: "default" | "muted";
  padding?: "none" | "md";
  class?: string;
}

const {
  tag = "div",
  variant = "default",
  padding = "md",
  class: className = "",
} = Astro.props as Props;

const baseStyles = "border border-border rounded-xl overflow-hidden";

const VariantStyles: Record<string, string> = {
  default: "bg-card ",
  muted: "bg-accent ",
};

const Tag = tag;
---

<Tag
  class={cn(
    baseStyles,
    VariantStyles[variant],
    padding === "md" ? "p-4" : "p-0",
    className,
  )}
>
  <slot />
</Tag>
