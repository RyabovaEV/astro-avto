---
import SectionHeader from "./SectionHeader.astro";

interface Props {
  title: string;
  description?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  id: string;
  class?: string;
}

const {
  title,
  description,
  level = 2,
  id,
  class: className = "",
} = Astro.props as Props;

const headingId = id + "-title";
---

<section class={`section container ${className}`} aria-labelledby={headingId}>
  <SectionHeader
    title={title}
    description={description}
    level={level}
    id={headingId}
  >
    <slot name="action" slot="action" />
  </SectionHeader>
  <div class="mt-8">
    <slot />
  </div>
</section>
