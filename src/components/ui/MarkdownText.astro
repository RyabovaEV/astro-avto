---
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";

interface Props {
  content: string;
}
const { content } = Astro.props;

const row = await marked.parse(content, { breaks: true });

const safe = sanitizeHtml(row, {
  allowedTags: [
    "p",
    "strong",
    "a",
    "b",
    "i",
    "li",
    "ul",
    "ol",
    "br",
    "em",
    "span",
  ],
  allowedAttributes: {
    a: ["href", "name"],
    strong: ["class"],
  },
  allowedSchemes: ["http", "https", "mailto", "tel"],
});
---

<Fragment set:html={safe} />
